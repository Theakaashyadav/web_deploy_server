# Local development defaults. Production installation generates .env.
DATABASE_URL=file:../../../data/deployhub.db
DATA_DIR=./data
# GitHub static sites only; legacy explicitly restores the upload/build API.
DEPLOYMENT_MODE=github-static
DASHBOARD_PORT=3100
API_PORT=4100
RUNTIME_PORT=4101
API_ORIGIN=http://127.0.0.1:4100
DASHBOARD_ORIGIN=http://localhost:3100
SITE_DOMAIN=localhost
SITE_PROTOCOL=http
SITE_PORT=4101
NODE_ENV=development
# Production: choose a different registrable domain from ADMIN_DOMAIN.
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=admin@example.com
POSTGRES_USER=deployhub
POSTGRES_DB=deployhub
# Generated by installer; never use an example value in production.
POSTGRES_PASSWORD=
REDIS_URL=
ENCRYPTION_KEY=
SETUP_TOKEN=
DATA_PATH=./data
BUILD_DOCKER_ENABLED=false
RUNTIME_DOCKER_ENABLED=true
RUNTIME_DOCKER_GATEWAY=host
RUNTIME_DOCKER_NETWORK=deployhub-runtime
RUNTIME_BUILD_IMAGE=node:22-bookworm
BUILD_MEMORY_MB=2048
RUNTIME_MEMORY_MB=1024
MAX_RUNTIME_ARTIFACT_BYTES=4294967296
BUILD_IMAGE=node:22-alpine
BUILD_NETWORK=none
BUILD_HOST_DATA_DIR=
BUILD_CONCURRENCY=2
BUILD_TIMEOUT_MS=300000
MAX_UPLOAD_BYTES=104857600
