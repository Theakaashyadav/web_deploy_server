{
  "name": "@deployhub/cli",
  "version": "0.1.0",
  "description": "DeployHub cross-platform deployment CLI",
  "type": "module",
  "bin": {
    "deployhub": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package": {
      "types": "./dist/package.d.ts",
      "import": "./dist/package.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "commander": "14.0.2",
    "ignore": "7.0.5"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
