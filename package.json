{
  "name": "websynk-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/dashboard"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "preview": "node scripts/dev.mjs --production",
    "dev:website": "npm run dev -w @websynk/site",
    "build": "npm run build -w @websynk/site",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:browser": "node tests/e2e/landing-browser.mjs",
    "seo:audit": "node scripts/seo-audit.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
